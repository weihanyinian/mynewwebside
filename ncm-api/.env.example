# 复制为 .env 后按需修改（app.js 会通过 dotenv 加载）
PORT=3000
HOST=

# 与 npm 包文档一致：https://www.npmjs.com/package/@neteasecloudmusicapienhanced/api
# CORS_ALLOW_ORIGIN=*
ENABLE_GENERAL_UNBLOCK=true
ENABLE_FLAC=true
SELECT_MAX_BR=false
FOLLOW_SOURCE_ORDER=true
ENABLE_PROXY=false
# PROXY_URL=https://your-proxy-url.com/?proxy=
