*
!.dockerignore
!backend/**
!frontend/**
!docker/**

# 勿将本地 application.yml（通常含密钥）打进镜像
backend/src/main/resources/application.yml

# prune heavy/unneeded artifacts from included directories
backend/target
backend/.mvn
backend/**/node_modules
backend/.npm_cache
frontend/node_modules
frontend/dist
frontend/.vite
frontend/.npm_cache
