# 复制为 docker/.env：  cp docker/.env.example docker/.env

MYSQL_ROOT_PASSWORD=change-me-root-strong
MYSQL_DATABASE=blog
MYSQL_USER=blog
MYSQL_PASSWORD=change-me-app-strong

# openssl rand -base64 48
JWT_SECRET=change-me-long-random-secret-min-32-chars

# 浏览器访问博客时使用的源（逗号分隔、无空格）。阿里云填公网 IP 或域名，例如：
# APP_CORS_ALLOWED_ORIGINS=http://47.xxx.xxx.xxx,https://www.example.com
APP_CORS_ALLOWED_ORIGINS=http://localhost

# 宿主机映射端口（默认 80；若 80 被占用可改为 8080）
HTTP_PORT=80

JWT_EXPIRE_MINUTES=10080
VIEW_COUNTER_REDIS=false
BOOTSTRAP_ADMIN_PASSWORD=

# 看板娘 AI（可选）
AI_COMPANION_ENABLED=false
AI_COMPANION_API_KEY=

# 仅 docker-compose.images.yml / package-for-server.ps1 使用
IMAGE_TAG=latest
