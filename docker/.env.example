# 复制为 .env 后修改（切勿将 .env 提交到 Git）
# cp .env.example .env

MYSQL_ROOT_PASSWORD=请改为强密码
MYSQL_DATABASE=blog
MYSQL_USER=blog_user
MYSQL_PASSWORD=请改为强密码

# 至少 32 位随机串：openssl rand -base64 32
JWT_SECRET=请改为至少32字节的随机密钥

# 首次初始化管理员密码（可选，见后端 bootstrap 说明）
ADMIN_INIT_PASSWORD=

# 浏览器可访问的前端地址（逗号分隔、勿加空格）。使用统一入口 :88 时请包含 http://你的域名:88
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80,http://localhost:88,http://127.0.0.1:88,http://localhost:5173

# 仅 docker-compose.images.yml / package-for-server.ps1 导出包需要
IMAGE_TAG=latest

# 可选：阅读量缓冲写 Redis（需 Redis 可用）
# VIEW_COUNTER_REDIS=true
