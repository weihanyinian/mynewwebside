# 快速部署模板：复制为 deploy/.env 后可直接 docker compose（该文件可提交 Git；deploy/.env 已 gitignore）
# PowerShell: Copy-Item deploy/.env.example deploy/.env
# Bash:       cp deploy/.env.example deploy/.env
# 生产环境请修改全部密码与 JWT_SECRET、APP_CORS_ALLOWED_ORIGINS

# ============ MySQL ============
MYSQL_ROOT_PASSWORD=MyWebsite_Root_2026!
MYSQL_DATABASE=blog
MYSQL_USER=blog
MYSQL_PASSWORD=MyWebsite_Blog_2026!

# ============ JWT（至少 32 字符；生产请 openssl rand -base64 48）============
JWT_SECRET=mywebsite-jwt-dev-secret-change-in-production-32chars
JWT_EXPIRE_MINUTES=10080

# ============ CORS：浏览器访问站点的来源，逗号分隔无空格 ============
# 阿里云示例（把 47.96.xxx.xxx 换成 ECS 公网 IP；有域名再加 https://你的域名）
# APP_CORS_ALLOWED_ORIGINS=http://47.96.xxx.xxx,https://www.yourdomain.com
# 本地 Docker：
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80

# ============ 对外 HTTP 端口 ============
HTTP_PORT=80

# ============ 可选 ============
VIEW_COUNTER_REDIS=false
# 首次部署创建 admin 用户（用户名固定为 admin）；忘记密码时用 reset-admin-on-server.sh 重置
BOOTSTRAP_ADMIN_PASSWORD=admin123
AI_COMPANION_ENABLED=false
AI_COMPANION_API_KEY=

# ============ 仅 docker-compose.images 流程 ============
IMAGE_TAG=latest
